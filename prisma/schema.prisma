generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String
  language     String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Yacht {
  id                  String              @id @default(cuid())
  yachtNumber         String              @unique
  name                String
  registrationNumber  String
  model               String
  builder             String
  yearBuilt           Int
  ownerId             String
  captainName         String
  status              String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  claims              Claim[]
  technicalSections   YachtTechnicalSection[]
}

model Claim {
  id               String       @id @default(cuid())
  yachtId          String
  yacht            Yacht        @relation(fields: [yachtId], references: [id])
  title            String
  description      String
  status           String       @default("new")
  priority         String       @default("medium")
  assignedTo       String?
  createdBy        String?
  warrantyStatus   String?
  supplierId       String?
  validationStatus String       @default("pending")
  validatedBy      String?
  validatedAt      DateTime?
  rejectedReason   String?
  rejectedBy       String?
  rejectedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  closedAt         DateTime?
  comments         Comment[]
  documents        Document[]
  activity         ActivityLog[]
  accessTokens     ClaimAccessToken[]
}

model Comment {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  userId    String
  message   String
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  yachtId     String?
  claimId     String?
  fileName    String
  storagePath String
  mimeType    String
  uploadedBy  String
  createdAt   DateTime @default(now())
  claim       Claim?   @relation(fields: [claimId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  details    String
  createdAt  DateTime @default(now())
  claimId    String?
  claim      Claim?   @relation(fields: [claimId], references: [id])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  companyName String
  email       String
  phone       String?
  createdAt   DateTime @default(now())
}

model ClaimAccessToken {
  id        String   @id @default(cuid())
  claimId   String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  claim     Claim    @relation(fields: [claimId], references: [id])
}

model YachtTechnicalSection {
  id          String               @id @default(cuid())
  yachtId     String
  yacht       Yacht                @relation(fields: [yachtId], references: [id])
  sectionName String
  displayName String
  sortOrder   Int
  createdAt   DateTime             @default(now())
  fields      YachtTechnicalField[]
}

model YachtTechnicalField {
  id          String                 @id @default(cuid())
  sectionId   String
  section     YachtTechnicalSection @relation(fields: [sectionId], references: [id])
  fieldName   String
  displayName String
  fieldType   String
  value       String?
  unit        String?
  isCustom    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id        String   @id @default(cuid())
  role      String
  resource  String
  action    String
  createdAt DateTime @default(now())
}
