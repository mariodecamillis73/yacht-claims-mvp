generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String
  isActive     Boolean @default(true)
  language     String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Yacht {
  hullNumber String   @id
  name       String
  yearBuilt  Int
  ownerId    String
  captainName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveryDate DateTime?
  warrantyYears Int?
  warrantyExpiresAt DateTime?
  equipmentJson String @default("{}")

  claims Claim[]
}

model Claim {
  id               String    @id @default(cuid())
  yachtHullNumber  String
  yacht            Yacht     @relation(fields: [yachtHullNumber], references: [hullNumber])
  title            String
  description      String
  status           String    @default("new")
  priority         String    @default("medium")
  assignedTo       String?
  createdBy        String?
  supplierId       String?
  warrantyStatus   String?
  validationStatus String    @default("pending")
  validatedBy      String?
  validatedAt      DateTime?
  rejectedReason   String?
  rejectedBy       String?
  rejectedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  closedAt         DateTime?
  dueDate          DateTime?

  comments     Comment[]
  documents    Document[]
  activity     ActivityLog[]
  accessTokens ClaimAccessToken[]
}

model Comment {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  userId    String
  visibility String @default("internal")
  message   String
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  yachtId     String?
  claimId     String?
  fileName    String
  content     Bytes?
  visibility  String @default("internal")
  storagePath String
  mimeType    String
  uploadedBy  String
  createdAt   DateTime @default(now())

  claim Claim? @relation(fields: [claimId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  details    String
  createdAt  DateTime @default(now())
  claimId    String?
  claim      Claim?   @relation(fields: [claimId], references: [id])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  companyName String
  email       String
  phone       String?
  createdAt   DateTime @default(now())
}

model ClaimAccessToken {
  id        String   @id @default(cuid())
  claimId   String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id])
}

model Permission {
  id        String   @id @default(cuid())
  role      String
  resource  String
  action    String
  createdAt DateTime @default(now())
}

model YachtMember {
  id String @id @default(cuid())
  userId String
  hullNumber String
  @@unique([userId, hullNumber])
}

model ClaimGrant {
  id String @id @default(cuid())
  claimId String
  email String
  role String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  codeHash String?
  codeExpiresAt DateTime?
  codeSentAt DateTime?
  attempts Int @default(0)
}

model LoginAttempt {
  email String @id
  failures Int @default(0)
  windowStart DateTime @default(now())
}
